# ConnectSoar Backend Environment Configuration Template

# Server Configuration (Render automatically injects PORT)
PORT=8080
SERVER_PORT=8080

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Signing Secret (Minimum 256-bit entropy for HMAC-SHA256)
JWT_SECRET=your-256-bit-secret-key-change-this-in-production!

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app,https://your-frontend.onrender.com

# Logging Level
LOG_LEVEL_CONNECTSOAR=INFO
LOG_LEVEL_SPRING=INFO
