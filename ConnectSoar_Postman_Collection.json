				{
					"name": "01. Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.collectionVariables.set('token', jsonData.data.access_token);",
									"        console.log('Access token saved: ' + jsonData.data.access_token);",
									"    }",
									"    if (jsonData.data && jsonData.data.refresh_token) {",
									"        pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
									"    }",
									"    if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
									"        pm.collectionVariables.set('userId', jsonData.data.user.id);",
									"    }",
